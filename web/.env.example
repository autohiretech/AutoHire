# AutoHire web — environment variables. Copy to `.env` and adjust.
# The app is Supabase-only, so these are required to run it.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe publishable key (pk_test_… to start). The secret key lives only in the
# create-payment-intent Edge Function's secrets, never here.
VITE_STRIPE_PUBLISHABLE_KEY=

# Route checkout through the external payment-hold system instead of the direct
# Stripe / Flutterwave rails. Its credentials live only in Edge Function secrets
# (EXTERNAL_PAYMENTS_*). See docs/payments-external.md.
VITE_PAYMENTS_EXTERNAL=false

# Route checkout through PayHold — the escrow platform AutoHire is tenant #1 on.
# Takes precedence over VITE_PAYMENTS_EXTERNAL. PayHold owns the whole money
# path: it hosts the checkout page, holds the funds until both sides confirm,
# and pays hosts out. Credentials live only in Edge Function secrets
# (PAYHOLD_BASE_URL, PAYHOLD_API_KEY, PAYHOLD_WEBHOOK_SECRET).
# Connection steps: docs/payhold.md
VITE_PAYMENTS_PAYHOLD=false

# Run PayHold's checkout inside the booking page instead of navigating to it.
#
# Requires PayHold to serve `frame-ancestors … https://autohiretech.pages.dev`
# and to post its result back; leave this off until that is deployed, or every
# renter waits for a blank frame before the fallback redirects them.
#
# Even when on, this is a preference and not a promise. PayHold hands off to
# Flutterwave or Stripe to take the money, and Stripe Checkout refuses to be
# framed — so on that rail the frame goes blank mid-payment and the redirect
# completes the booking. The redirect path is load-bearing, not legacy.
VITE_PAYHOLD_EMBED=false
